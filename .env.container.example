# Copy to .env.container. This example contains no usable credentials.
# URL-encode special characters in POSTGRES_PASSWORD when writing DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql://postgres:replace-with-a-unique-database-password@postgres:5432/nexaai
REDIS_URL=redis://redis:6379/0
# Phase 17 local containers intentionally retain shared local storage.
DOCUMENT_STORAGE_DRIVER=local
JWT_SECRET=replace-with-at-least-32-random-bytes
GEMINI_API_KEY=replace-with-your-provider-key
GEMINI_MODEL=gemini-3.1-flash-lite
API_ALLOWED_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:5000/api/v1
API_PORT=5000
FRONTEND_PORT=8080
# These host ports can change without changing the internal service URLs above.
POSTGRES_PORT=5432
REDIS_PORT=6379
