# Copy to .env.production on the server. This file contains placeholders only.
APP_DOMAIN=app.example.com
TLS_EMAIL=operator@example.com

# Immutable registry tags built from one verified commit. Do not use latest.
BACKEND_IMAGE=ghcr.io/replace-owner/nexaai-backend:replace-git-sha
MIGRATION_IMAGE=ghcr.io/replace-owner/nexaai-migration:replace-git-sha
FRONTEND_IMAGE=ghcr.io/replace-owner/nexaai-frontend:replace-git-sha

# Use long independent random values. URL-encode passwords inside URLs.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://postgres:replace-with-url-encoded-password@postgres:5432/nexaai
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-bytes
GEMINI_API_KEY=replace-with-your-provider-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Cloudflare R2 uses region auto and an account-specific HTTPS endpoint. The
# bucket must remain private; browsers never receive these credentials.
DOCUMENT_STORAGE_DRIVER=s3
S3_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=nexaai-production-documents
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
S3_FORCE_PATH_STYLE=false

# Restic stores encrypted database dumps in a separate private bucket/prefix.
BACKUP_REPOSITORY=s3:https://replace-account-id.r2.cloudflarestorage.com/nexaai-production-backups
BACKUP_PASSWORD=replace-with-an-independent-long-backup-password
BACKUP_S3_ACCESS_KEY_ID=replace-with-backup-only-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-backup-only-secret-key

# Browser requests use the same public HTTPS origin served by Caddy.
API_ALLOWED_ORIGINS=https://app.example.com
VITE_API_BASE_URL=https://app.example.com/api/v1
