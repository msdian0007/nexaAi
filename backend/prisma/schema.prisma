// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  uploadedDocuments Document[]
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  documents Document[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Conversation ownership uses this membership, not just an unrelated user ID.
  conversations Conversation[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

model Document {
  id             String         @id @default(uuid())
  organizationId String
  uploadedById   String

  name           String
  originalName   String
  mimeType       String
  size           Int
  storagePath    String

  extractedText  String?

  status         DocumentStatus @default(UPLOADED)
  errorMessage   String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  chunks DocumentChunk[]

  @@index([organizationId])
  @@index([uploadedById])
  @@index([organizationId, status])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String

  content    String
  chunkIndex Int

  embeddingStatus String @default("PENDING")
  embedding       Unsupported("vector(384)")?

  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@unique([documentId, chunkIndex])
}

enum MessageRole {
  USER
  ASSISTANT
}

// These values match the validated RAG response, including partial/no-evidence answers.
enum AnswerStatus {
  answered
  insufficient_information
  conflicting_evidence
}

model Conversation {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  title          String   @db.VarChar(200)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // The composite foreign key requires the owner to belong to this organization.
  // Removing that membership deletes its private conversations and their messages.
  owner OrganizationMember @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  messages Message[]

  // This key lets child records enforce that their organization matches the parent.
  @@unique([id, organizationId])
  @@index([organizationId, userId, updatedAt, id])
  @@index([userId, organizationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  organizationId String
  role           MessageRole
  content        String
  // Explicit ordering avoids ambiguous timestamps when a question/answer are saved together.
  sequence       Int
  // User questions have no answer status. Assistant messages store validated outcomes.
  answerStatus   AnswerStatus?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sources MessageSource[]

  @@unique([id, organizationId])
  @@unique([conversationId, sequence])
  @@index([organizationId, conversationId])
}

model MessageSource {
  id             String @id @default(uuid())
  messageId      String
  organizationId String
  sourceId       String
  // Snapshot metadata, deliberately without document/chunk foreign keys:
  // renaming, reprocessing or deleting a document must not rewrite a historical citation.
  documentId     String
  chunkId        String
  documentName   String
  chunkIndex     Int
  similarity     Float

  message Message @relation(fields: [messageId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([messageId, sourceId])
  @@index([organizationId, messageId])
}
